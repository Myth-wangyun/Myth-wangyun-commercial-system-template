# ============================================
# 清美教育管理系统 - 环境变量配置示例
# 复制此文件为 .env 并修改相应的值
# ============================================

# ============================================
# 应用配置
# ============================================
APP_NAME=清美教育管理系统
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ============================================
# 服务器配置
# ============================================
HOST=127.0.0.1
PORT=8000
RELOAD=True

# ============================================
# 数据库配置（PostgreSQL）
# ============================================
# PostgreSQL数据库连接信息
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=qmjy
DB_CHARSET=utf8

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================
# JWT认证配置
# ============================================
# 密钥（请修改为随机字符串）
SECRET_KEY=your-secret-key-here-please-change-it
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS配置
# ============================================
# 允许的前端域名（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# ============================================
# 文件上传配置
# ============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=xlsx,xls,csv,pdf,jpg,jpeg,png

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# ============================================
# 分页配置
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# 百度营销API配置
# ============================================
# 应用ID（审核通过后在百度开发者中心获取）
BAIDU_MARKETING_APP_ID=your_app_id_here
# 应用密钥（审核通过后在百度开发者中心获取，注意保密）
BAIDU_MARKETING_SECRET_KEY=your_secret_key_here
# 回调地址（需要与百度开发者中心填写的一致）
BAIDU_MARKETING_CALLBACK_URL=http://116.255.152.27:8000/api/v1/baidu-marketing/oauth/callback
# 开发者用户ID（你的百度推广账户ID）
BAIDU_MARKETING_DEVELOPER_USER_ID=123456
# 权限范围（默认财务+账号信息）
BAIDU_MARKETING_SCOPE=1_0_1,1_2_1_1

