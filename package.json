{
  "name": "qm-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:prod": "vite --mode production",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "build:production": "vite build --mode production",
    "extract:hr-prototypes": "node scripts/development/extract-hr-dashboard-prototypes.mjs",
    "preview": "vite preview",
    "preview:test": "vite preview --port 5173 --host 0.0.0.0",
    "preview:production": "vite preview --mode production --port 5173 --host 0.0.0.0",
    "serve": "python -m http.server 5173 --directory dist --bind 0.0.0.0",
    "lint": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\" --quiet",
    "lint:strict": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\" --quiet --config eslint.strict.config.js",
    "lint:fix": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier \"frontend/**/*.{ts,tsx,js,jsx,json,md}\" --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:integration": "VITE_API_BASE_URL=http://localhost:8000/api/v1 vitest --run frontend/test/*.integration.test.ts",
    "test:e2e:seed": "node backend/test/puppeteer/seed-teacher-function-analysis-dependencies.js",
    "test:seed:culture": "node frontend/test/seed-culture-data.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "quality:frontend": "npm run typecheck && npm run lint && npm run test:run",
    "quality:frontend:strict": "npm run typecheck && npm run lint:strict && npm run test:run",
    "quality:backend:mypy": "node scripts/development/repo_python.mjs -m mypy --config-file mypy.ini backend/app",
    "quality:backend:pytest": "node scripts/development/repo_python.mjs -m pytest -q backend/test/units",
    "quality:backend:pytest:smoke": "node scripts/development/repo_python.mjs -m pytest -q -m smoke backend/test/units",
    "quality:backend:pytest:integration": "node scripts/development/repo_python.mjs -m pytest -q -c pytest.integration.ini -m integration backend/test",
    "quality:backend:static": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh backend-static",
    "quality:backend:strict": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh backend-static-strict",
    "quality:backend:test": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh backend-test",
    "quality:backend:test:strict": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh backend-test-strict",
    "quality:preflight": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh preflight",
    "quality:strict": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh strict",
    "quality:ci": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh ci",
    "quality:full": "node scripts/development/repo_bash.mjs scripts/development/run_quality_gates.sh full",
    "quality:capture": "node scripts/development/repo_bash.mjs scripts/development/capture_static_outputs.sh --include-quality-ci",
    "quality:baseline": "node scripts/development/repo_bash.mjs scripts/development/capture_static_outputs.sh --include-quality-ci && node scripts/development/repo_python.mjs scripts/development/collect_static_baseline.py --output specs/static-debt/current-baseline.json --include-quality-ci --from-captured-outputs && node scripts/development/repo_python.mjs scripts/development/write_round_static_report.py && node scripts/development/repo_python.mjs scripts/development/run_static_batch.py init --force",
    "quality:report": "node scripts/development/repo_python.mjs scripts/development/render_static_report.py",
    "quality:round-report": "node scripts/development/repo_python.mjs scripts/development/write_round_static_report.py",
    "quality:batch:init": "node scripts/development/repo_python.mjs scripts/development/run_static_batch.py init --force",
    "quality:batch:status": "node scripts/development/repo_python.mjs scripts/development/run_static_batch.py status"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.4.15",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.2",
    "@types/exceljs": "^0.5.3",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^24.10.1",
    "@types/stats.js": "^0.17.4",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.0.14",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react-scan": "^0.4.3",
    "stats.js": "^0.17.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.1.7",
    "vite-plugin-compression2": "^2.5.1",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@ant-design/fast-color": "^3.0.0",
    "@ant-design/icons": "^6.1.0",
    "@playwright/test": "^1.57.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/uuid": "^10.0.0",
    "antd": "^5.27.6",
    "axios": "^1.13.6",
    "dayjs": "^1.11.19",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "puppeteer": "^24.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.3.0",
    "uuid": "^13.0.0",
    "vconsole": "^3.15.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  }
}
